# .env.example
SILVINA_APP_NAME="Silvina Editorial Assistant"

# APP MODE: PROD or DEBUG
APP_MODE=DEBUG

# Absolute path of the SQLite database storing analysis metrics and AI audit records
METRICS_DATABASE_PATH=

# Absolute path of the rotating application log file
LOG_FILE_PATH=

# Minimum severity written to the log file: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Number of daily rotated log files to keep before the oldest is deleted
LOG_RETENTION_DAYS=14

# Ollama backend connection (OllamaGeneratorAdapter)
# OLLAMA_MODEL_NAME=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-IQ4_XS
OLLAMA_MODEL_NAME=gemma4-26b-adapted
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINK=false
OLLAMA_MODEL_KEEP_ALIVE=15m
OLLAMA_WARMUP_ON_STARTUP=true

# DEBUG-only selectable external LLM adapter
USE_EXTERNAL_LLM=false
LLM_PROVIDER=claude
#Models: claude-opus-5-5 claude-sonnet-5-5 claude-haiku-4-5-20251001
EXTERNAL_LLM_MODEL_NAME=claude-haiku-4-5-20251001
EXTERNAL_LLM_THINK=false

# Article classification text sample (ArticleClassificationTextSampler)
ARTICLE_CLASSIFICATION_SAMPLE_INTRODUCTION_CHARACTER_LIMIT=3500
ARTICLE_CLASSIFICATION_SAMPLE_CONCLUSION_CHARACTER_LIMIT=2500
ARTICLE_CLASSIFICATION_SAMPLE_FALLBACK_CHARACTER_LIMIT=6000
ARTICLE_CLASSIFICATION_BIBLIOGRAPHY_HEADER_MAX_LENGTH=30

GRAMMAR_MAX_PARAGRAPHS=20
GRAMMAR_MAX_CHARS=5000
GRAMMAR_MAX_ERRORS=10

# Article classification (ArticleClassifier)
ARTICLE_CLASSIFIER_TEMPERATURE=0.1
ARTICLE_CLASSIFIER_NUM_PREDICT=300
ARTICLE_SIZE_SHORT_MIN_CHARS=16000
ARTICLE_SIZE_SHORT_MAX_CHARS=24000
ARTICLE_SIZE_UNDEFINED_MIN_CHARS=24001
ARTICLE_SIZE_UNDEFINED_MAX_CHARS=35999
ARTICLE_SIZE_LONG_MIN_CHARS=36000
ARTICLE_SIZE_LONG_MAX_CHARS=40000

# Quality analysis (QualityTextSampler, QualityLevelResolver)
QUALITY_MIN_SAMPLE_WORD_COUNT=400
QUALITY_TEXT_SAMPLE_CHARACTER_LIMIT=8000
QUALITY_TEXT_SAMPLE_REFERENCE_LINE_PREFIX_LENGTH=80
QUALITY_TEXT_SAMPLE_INTRODUCTION_PARAGRAPH_COUNT=3
QUALITY_TEXT_SAMPLE_MIDDLE_PARAGRAPH_COUNT=2
QUALITY_TEXT_SAMPLE_CONCLUSION_PARAGRAPH_LIMIT=3
QUALITY_TEXT_SAMPLE_FALLBACK_TAIL_PARAGRAPH_COUNT=2
QUALITY_TEXT_SAMPLE_CONCLUSION_HEADER_MARKER=conclusi
QUALITY_LEVEL_EXCELLENT_THRESHOLD=9.0
QUALITY_LEVEL_GOOD_THRESHOLD=7.0
QUALITY_LEVEL_ACCEPTABLE_THRESHOLD=5.0
QUALITY_LEVEL_NEEDS_IMPROVEMENT_THRESHOLD=3.0

# Structure validation
STRUCTURE_MAX_HEADER_LENGTH=100

# Citation extraction
CITATION_MAX_AUTHOR_NAME_LENGTH=100

# Grammar checking
GRAMMAR_MAX_REPLACEMENTS=3

# Recommendation thresholds (RecommendationBuilder, PublicationVerdictEvaluator)
PUBLISH_THRESHOLD=7.0
QUALITY_THRESHOLD=7.0
GRAMMAR_THRESHOLD=7.0
DIMENSION_THRESHOLD=6.0
CITATION_MATCH_THRESHOLD=90.0
CRITICAL_CITATION_MATCH_THRESHOLD=50.0
CITATION_COUNT_THRESHOLD=10
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CRITICAL_QUALITY_THRESHOLD=5.0
CRITICAL_GRAMMAR_THRESHOLD=5.0

# Report export (DocxReportAdapter)
REPORT_SCORE_HIGH_THRESHOLD=8.0
REPORT_SCORE_MEDIUM_THRESHOLD=6.0
REPORT_WORDS_PER_PAGE=250
REPORT_MAX_ERRORS_DISPLAYED=5
REPORT_CONTEXT_TRUNCATION_LIMIT=150
REPORT_MAX_REPLACEMENTS=3
