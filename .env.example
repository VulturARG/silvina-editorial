# .env.example
SILVINA_APP_NAME="Silvina Editorial Assistant"

# APP MODE: PROD or DEBUG
APP_MODE=DEBUG

# Absolute path of the SQLite database storing analysis metrics and AI audit records
METRICS_DATABASE_PATH=

# Absolute path of the rotating application log file
LOG_FILE_PATH=

# Minimum severity written to the log file: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Number of daily rotated log files to keep before the oldest is deleted
LOG_RETENTION_DAYS=14

# Ollama backend connection (OllamaGeneratorAdapter)
# OLLAMA_MODEL_NAME=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-IQ4_XS
OLLAMA_MODEL_NAME=gemma4-26b-adapted
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINK=false
OLLAMA_MODEL_KEEP_ALIVE=15m
OLLAMA_WARMUP_ON_STARTUP=true
OLLAMA_NUM_CTX=16384

# DEBUG-only selectable external LLM adapter
USE_EXTERNAL_LLM=false
LLM_PROVIDER=claude
#Models: claude-opus-5-5 claude-sonnet-5-5 claude-haiku-4-5-20251001
EXTERNAL_LLM_MODEL_NAME=claude-haiku-4-5-20251001
EXTERNAL_LLM_THINK=false
